#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/context_common.sh"

load_workflow_env

status_ok=0
status_warn=0

BUILD_DRIVER="${AGENT_BUILD_DRIVER:-claude}"
CLAUDE_BIN="${CLAUDE_CMD:-claude}"
OPENCODE_BIN="${OPENCODE_CMD:-opencode}"
HERMES_BIN="${HERMES_CMD:-hermes}"
CODEX_BIN="$(resolve_codex_cmd || true)"

check_binary() {
  local label="$1"
  local cmd="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '[ok]   %s -> %s\n' "$label" "$(command -v "$cmd")"
    status_ok=$((status_ok + 1))
  else
    printf '[warn] %s missing (%s)\n' "$label" "$cmd"
    status_warn=$((status_warn + 1))
  fi
}

check_binary_info() {
  local label="$1"
  local cmd="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf '[ok]   %s -> %s\n' "$label" "$(command -v "$cmd")"
    status_ok=$((status_ok + 1))
  else
    printf '[info] %s not installed (not active driver)\n' "$label"
  fi
}

check_path() {
  local label="$1"
  local target="$2"
  if [[ -e "$target" ]]; then
    printf '[ok]   %s -> %s\n' "$label" "$target"
    status_ok=$((status_ok + 1))
  else
    printf '[warn] %s missing (%s)\n' "$label" "$target"
    status_warn=$((status_warn + 1))
  fi
}

check_path_info() {
  local label="$1"
  local target="$2"
  if [[ -e "$target" ]]; then
    printf '[ok]   %s -> %s\n' "$label" "$target"
    status_ok=$((status_ok + 1))
  else
    printf '[info] %s missing (not active driver) (%s)\n' "$label" "$target"
  fi
}

printf 'Agent Stack Doctor\n'
printf '==================\n\n'

printf 'Effective config\n'
printf '%s\n' '----------------'
printf 'workflow env: %s\n' "$WORKFLOW_ENV"
printf 'build driver: %s\n' "$BUILD_DRIVER"
printf 'claude cmd: %s\n' "$CLAUDE_BIN"
printf 'opencode cmd: %s\n' "$OPENCODE_BIN"
printf 'codex cmd: %s\n' "${CODEX_BIN:-<missing>}"
printf 'hermes cmd: %s\n' "$HERMES_BIN"
printf 'review mode: %s\n' "${CODEX_REVIEW_MODE:-working-tree}"
printf 'research profile: %s\n' "${HERMES_RESEARCH_PROFILE:-<default>}"
printf 'research toolsets: %s\n' "${HERMES_RESEARCH_TOOLSETS:-web,browser}"
printf 'context enabled: %s\n' "${AI_CONTEXT_ENABLED:-1}"
printf 'context dir: %s\n\n' "$(context_dir)"

printf 'Checks\n'
printf '%s\n' '------'
check_binary 'git' git

case "$BUILD_DRIVER" in
  claude)
    check_binary 'claude (primary)' "$CLAUDE_BIN"
    check_binary_info 'opencode' "$OPENCODE_BIN"
    ;;
  opencode)
    check_binary 'opencode (primary)' "$OPENCODE_BIN"
    check_binary_info 'claude' "$CLAUDE_BIN"
    ;;
  *)
    printf '[warn] invalid build driver (%s); expected claude or opencode\n' "$BUILD_DRIVER"
    status_warn=$((status_warn + 1))
    ;;
esac

check_binary 'hermes' "$HERMES_BIN"
if [[ -n "$CODEX_BIN" ]]; then
  printf '[ok]   codex -> %s\n' "$CODEX_BIN"
  status_ok=$((status_ok + 1))
else
  printf '[warn] codex missing (need codex or npx)\n'
  status_warn=$((status_warn + 1))
fi

check_path 'workflow env' "$WORKFLOW_ENV"
check_path 'shared output contract' "$HOME/.config/agent-stack/output-contract.md"
check_path 'context agent rules' "$(context_dir)/agent-rules.md"
check_path 'context memory policy' "$(context_dir)/memory-policy.md"
check_path 'context privacy boundary' "$(context_dir)/privacy-boundary.md"

case "$BUILD_DRIVER" in
  claude)
    check_path 'Claude global CLAUDE.md' "$HOME/.claude/CLAUDE.md"
    check_path_info 'OpenCode global AGENTS' "$HOME/.config/opencode/AGENTS.md"
    ;;
  opencode)
    check_path 'OpenCode global AGENTS' "$HOME/.config/opencode/AGENTS.md"
    check_path_info 'Claude global CLAUDE.md' "$HOME/.claude/CLAUDE.md"
    ;;
  *)
    check_path_info 'Claude global CLAUDE.md' "$HOME/.claude/CLAUDE.md"
    check_path_info 'OpenCode global AGENTS' "$HOME/.config/opencode/AGENTS.md"
    ;;
esac

check_path 'Codex global AGENTS' "$HOME/.codex/AGENTS.md"
check_path 'Codex repo-review skill' "$HOME/.agents/skills/repo-review/SKILL.md"
check_path 'Codex repo-brief skill' "$HOME/.agents/skills/repo-brief/SKILL.md"
check_path 'Hermes SOUL' "$HOME/.hermes/SOUL.md"

if context_enabled; then
  if review_context_files; then
    status_ok=$((status_ok + 1))
  else
    status_warn=$((status_warn + 1))
  fi
else
  printf '[info] context loading disabled by AI_CONTEXT_ENABLED=0\n'
fi

if git rev-parse --show-toplevel >/dev/null 2>&1; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  printf '[ok]   current repo -> %s\n' "$REPO_ROOT"
  mkdir -p "$REPO_ROOT/.ai/tmp" "$REPO_ROOT/.codex/tmp"
  check_path 'repo .ai/tmp' "$REPO_ROOT/.ai/tmp"
  check_path 'repo .codex/tmp' "$REPO_ROOT/.codex/tmp"
else
  printf '[warn] current directory is not inside a git repository\n'
  status_warn=$((status_warn + 1))
fi

if grep -F "$HOME/.agents/skills" "$HOME/.hermes/config.yaml" >/dev/null 2>&1; then
  printf '[ok]   Hermes external skills dir configured\n'
  status_ok=$((status_ok + 1))
else
  printf '[warn] Hermes config does not obviously reference %s\n' "$HOME/.agents/skills"
  status_warn=$((status_warn + 1))
fi

printf '\nSummary: %d ok, %d warning(s)\n' "$status_ok" "$status_warn"

if [[ "$status_warn" -gt 0 ]]; then
  exit 1
fi
