#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/common.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/prompts.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../lib/context_common.sh"

usage() {
  cat <<'EOF'
Usage: ai-build [--driver claude|opencode] [--model NAME] [--no-auto-approve] [--dump-prompt] [task text]

Options:
  --driver             override AGENT_BUILD_DRIVER for this run only
  --model              override build model for the active driver
  --no-auto-approve    do not pass auto-approve / skip-permissions flags
  --dump-prompt        save the generated prompt into <repo>/.ai/tmp/
EOF
}

load_workflow_env
require_command git
ensure_git_repo
ensure_repo_tmp_dirs

BUILD_DRIVER="${AGENT_BUILD_DRIVER:-claude}"
BUILD_MODEL_OVERRIDE=""
DISABLE_AUTO_APPROVE=0
DUMP_PROMPT=0
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --driver)
      shift
      BUILD_DRIVER="$(require_value_arg --driver "${1-}")"
      ;;
    --model)
      shift
      BUILD_MODEL_OVERRIDE="$(require_value_arg --model "${1-}")"
      ;;
    --no-auto-approve)
      DISABLE_AUTO_APPROVE=1
      ;;
    --dump-prompt)
      DUMP_PROMPT=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ $# -gt 0 ]]; do
        POSITIONAL+=("$1")
        shift
      done
      break
      ;;
    *)
      POSITIONAL+=("$1")
      ;;
  esac
  shift
done

TASK_TEXT="$(collect_input "${POSITIONAL[@]}")"
CONTEXT_BUNDLE="$(generate_context_bundle "$BUILD_DRIVER")"
PROMPT="$(build_prompt "$TASK_TEXT" "$CONTEXT_BUNDLE")"

if [[ "$DUMP_PROMPT" -eq 1 ]]; then
  PROMPT_PATH="$(write_debug_file "$REPO_ROOT/.ai/tmp" 'build-prompt' "$PROMPT")"
  log "Saved build prompt to $PROMPT_PATH"
fi

case "$BUILD_DRIVER" in
  claude)
    CLAUDE_BIN="${CLAUDE_CMD:-claude}"
    require_command "$CLAUDE_BIN"
    MODEL_NAME="${BUILD_MODEL_OVERRIDE:-${CLAUDE_BUILD_MODEL:-}}"
    AUTO_APPROVE="${CLAUDE_AUTO_APPROVE:-1}"
    if [[ "$DISABLE_AUTO_APPROVE" -eq 1 ]]; then
      AUTO_APPROVE=0
    fi

    cmd=("$CLAUDE_BIN" -p "$PROMPT")
    if [[ -n "$MODEL_NAME" ]]; then
      cmd+=(--model "$MODEL_NAME")
    fi
    if [[ "$AUTO_APPROVE" == "1" ]]; then
      cmd+=(--dangerously-skip-permissions)
    fi

    log "Running Claude build in $REPO_ROOT"
    exec "${cmd[@]}"
    ;;

  opencode)
    OPENCODE_BIN="${OPENCODE_CMD:-opencode}"
    require_command "$OPENCODE_BIN"
    AGENT_NAME="${OPENCODE_BUILD_AGENT:-build}"
    MODEL_NAME="${BUILD_MODEL_OVERRIDE:-${OPENCODE_BUILD_MODEL:-}}"
    AUTO_APPROVE="${OPENCODE_AUTO_APPROVE:-1}"
    if [[ "$DISABLE_AUTO_APPROVE" -eq 1 ]]; then
      AUTO_APPROVE=0
    fi

    cmd=("$OPENCODE_BIN" run --agent "$AGENT_NAME")
    if [[ -n "$MODEL_NAME" ]]; then
      cmd+=(--model "$MODEL_NAME")
    fi
    if [[ "$AUTO_APPROVE" == "1" ]]; then
      cmd+=(--dangerously-skip-permissions)
    fi
    cmd+=("$PROMPT")

    log "Running OpenCode build in $REPO_ROOT"
    exec "${cmd[@]}"
    ;;

  *)
    die "Unknown AGENT_BUILD_DRIVER: $BUILD_DRIVER (expected: claude | opencode)"
    ;;
esac
