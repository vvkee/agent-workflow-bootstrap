# Shared workflow env for agent-workflow-bootstrap v1

# Command names / absolute paths
OPENCODE_CMD=opencode
CODEX_CMD=codex
HERMES_CMD=hermes

# OpenCode build defaults
OPENCODE_BUILD_AGENT=build
OPENCODE_BUILD_MODEL=
OPENCODE_AUTO_APPROVE=1

# Codex review defaults
CODEX_REVIEW_MODEL=
CODEX_REVIEW_MODE=working-tree

# Hermes research defaults
# Leave empty to use the default Hermes profile.
HERMES_RESEARCH_PROFILE=
HERMES_RESEARCH_TOOLSETS=web,browser

# Optional: custom title prefixes or other future settings
AI_BUILD_TITLE=
AI_REVIEW_TITLE=
AI_RESEARCH_TITLE=
